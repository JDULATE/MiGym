# Deploy MiGym on Railway.app with a free .US.KG domain
# Railway free tier: 500 hours/month, 512 MB RAM, persistent volume
# Railway auto-detects Docker Compose but we use a single Dockerfile for simplicity.

FROM node:22-alpine AS build
WORKDIR /app
COPY frontend/package.json frontend/package-lock.json* ./
COPY frontend/ .
RUN npm ci 2>/dev/null || npm install
RUN npm run build

FROM node:22-alpine
WORKDIR /app
COPY api/package.json api/package-lock.json* ./
RUN npm ci 2>/dev/null || npm install
COPY api/server.js .
COPY --from=build /app/dist ./public
COPY frontend/src/lib ./public-lib

ENV NODE_ENV=production
ENV PORT=3000
ENV DATA_DIR=/data

EXPOSE 3000
CMD ["node", "server.js"]
